# Clés API (laisser vide si fournisseur non utilisé)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Modèle par défaut au démarrage (convention de nommage LiteLLM)
DEFAULT_MODEL=claude-sonnet-4-6

# LLM Local (Ollama / LM Studio / JAN)
# Ollama   : http://localhost:11434/v1
# LM Studio: http://localhost:1234/v1
# JAN      : http://localhost:1337/v1
LOCAL_LLM_ENDPOINT=http://localhost:11434/v1
LOCAL_LLM_MODEL=ollama/mistral-small3.2
# LOCAL_LLM_MODEL=ollama/qwen2.5:32b   # 32 Go RAM — meilleure qualité pour CLA-001

# ── Mode démonstration (déploiement public vitrine) ──────────────────────────
# Laisser à 0 pour une installation normale : c'est le mode institutionnel, le
# seul qui traite VOS données. Passer à 1 réserve le backend à une vitrine
# publique — il impose alors le CSV de démonstration embarqué (aucune donnée
# utilisateur n'est analysée), le modèle DEMO_MODEL et la clé OPENAI_API_KEY du
# serveur, et applique des quotas (1 parcours/IP/jour + plafond de tokens/jour).
DEMO_MODE=0
DEMO_MODEL=gpt-5.4-mini-2026-03-17
DEMO_DAILY_TOKEN_CAP=200000
# Durcissement : plafond de taille du corps de requête en démo (Mo). La démo
# n'analyse que le CSV embarqué, donc aucun corps volumineux n'est légitime.
DEMO_MAX_BODY_MB=2
# Chemin du CSV de démo (défaut : backend/demo_assets/demo.csv)
# DEMO_CSV_PATH=
# Secret exigé sur l'en-tête X-Demo-Proxy-Secret (injecté par le proxy front).
# Laisser vide en dev local ; obligatoire en prod pour bloquer les appels directs.
DEMO_PROXY_SECRET=
# Sel d'anonymisation des IP (sinon généré aléatoirement au démarrage).
DEMO_IP_SALT=
# CORS : origine(s) autorisée(s), séparées par des virgules. Vide ⇒ "*".
ALLOWED_ORIGINS=
