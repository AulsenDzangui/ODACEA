# Clés API (laisser vide si fournisseur non utilisé)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Modèle par défaut au démarrage (convention de nommage LiteLLM)
DEFAULT_MODEL=claude-sonnet-4-6

# LLM Local (Ollama / LM Studio / JAN)
# Ollama   : http://localhost:11434/v1
# LM Studio: http://localhost:1234/v1
# JAN      : http://localhost:1337/v1
LOCAL_LLM_ENDPOINT=http://localhost:11434/v1
LOCAL_LLM_MODEL=ollama/mistral-small3.2
