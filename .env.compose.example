# Surcharges optionnelles pour `docker compose`.
# Copier en `.env` à la racine ; toutes les valeurs ont des défauts dans compose.yml.
#   cp .env.compose.example .env && docker compose up -d --build

# ── Modèle proposé par défaut dans l'UI au démarrage ──────────────────────────
# Convention de nommage LiteLLM. Pour un modèle local sur l'hôte, le point
# d'accès se règle dans l'UI (ex. http://host.docker.internal:11434/v1).
DEFAULT_MODEL=ollama/qwen2.5:14b

# ── Port d'exposition du front sur l'hôte ─────────────────────────────────────
ODACEA_WEB_PORT=9000

# ── Limites d'entrée ──────────────────────────────────────────────────────────
ODACEA_MAX_CSV_MB=20
ODACEA_MAX_CSV_ROWS=50000

# ── CORS (vide ⇒ "*") ─────────────────────────────────────────────────────────
# Le navigateur ne parle qu'au front (proxy same-origin) : laisser vide.
ALLOWED_ORIGINS=

# ── Clés cloud OPTIONNELLES ───────────────────────────────────────────────────
# Inutiles pour un déploiement 100 % local. Sinon, préférer la saisie dans l'UI
# (non persistée par défaut) à une clé en clair dans ce fichier.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Mode démonstration public (NON institutionnel) ────────────────────────────
# Laisser à 0 pour une installation d'archive. Voir la documentation du mode démonstration.
DEMO_MODE=0
NEXT_PUBLIC_DEMO_MODE=0
DEMO_PROXY_SECRET=
